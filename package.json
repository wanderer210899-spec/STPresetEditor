{
  "name": "prompt-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:webview": "vite build --config vite.config.webview.js",
    "test": "vitest run",
    "package:ext": "npm run build:webview && cd extension && npx --yes @vscode/vsce package --no-dependencies",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "floating-vue": "^5.2.2",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4",
    "vitest": "^4.1.9",
    "wrangler": "^4.45.0"
  }
}
