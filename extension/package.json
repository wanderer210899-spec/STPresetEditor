{
  "name": "stpreseteditor-local",
  "displayName": "STPresetEditor — Local Files",
  "description": "Edit SillyTavern presets from local files using the STPresetEditor UI.",
  "version": "0.0.1",
  "publisher": "wanderer210899",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanderer210899-spec/stpreseteditor"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sillytavern",
    "preset",
    "ai",
    "prompt",
    "editor"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:stpe.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stpe.open",
        "title": "Open in STPresetEditor",
        "category": "STPresetEditor",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  }
}
