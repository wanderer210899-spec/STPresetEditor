{
  "name": "stpreseteditor-local",
  "displayName": "STPresetEditor — Local Files",
  "description": "Edit SillyTavern presets from local files using the STPresetEditor UI, with optional account-based cloud sync.",
  "version": "0.5.3",
  "publisher": "wanderer210899",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanderer210899-spec/stpreseteditor"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sillytavern",
    "preset",
    "ai",
    "prompt",
    "editor"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:stpe.open",
    "onCommand:stpe.openEditor",
    "onCommand:stpe.pullFromCloud",
    "onView:stpePresets"
  ],
  "contributes": {
    "configuration": {
      "title": "STPresetEditor",
      "properties": {
        "stpe.cloudUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your **own** STPresetEditor cloud deployment, e.g. `https://<your-worker>.workers.dev`. Leave blank for local-only (no cloud). The extension never contacts any server until you set this. Deploy your own Worker from the project README, then paste its URL here and connect with an **API key** (generated in the web app: Settings → Cloud sync) from the editor's Settings → Cloud sync. You can also set this from that panel."
        },
        "stpe.presetGlob": {
          "type": "string",
          "default": "**/*.json",
          "markdownDescription": "Glob for the **ST Presets** Explorer view. Matching `.json` files that parse as SillyTavern presets (an object with a `prompts` array) are listed; everything else is skipped silently. `node_modules` is always excluded."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "stpePresets",
          "name": "ST Presets",
          "icon": "$(json)"
        }
      ]
    },
    "commands": [
      {
        "command": "stpe.open",
        "title": "Open in STPresetEditor",
        "category": "STPresetEditor",
        "icon": "$(edit)"
      },
      {
        "command": "stpe.openEditor",
        "title": "Open editor (no file)",
        "category": "STPresetEditor",
        "icon": "$(window)"
      },
      {
        "command": "stpe.pullFromCloud",
        "title": "Pull library from cloud",
        "category": "STPresetEditor",
        "icon": "$(cloud-download)"
      },
      {
        "command": "stpe.refreshPresets",
        "title": "Refresh presets",
        "category": "STPresetEditor",
        "icon": "$(refresh)"
      },
      {
        "command": "stpe.newPreset",
        "title": "New preset",
        "category": "STPresetEditor",
        "icon": "$(new-file)"
      },
      {
        "command": "stpe.duplicatePreset",
        "title": "Duplicate",
        "category": "STPresetEditor",
        "icon": "$(files)"
      },
      {
        "command": "stpe.renamePreset",
        "title": "Rename…",
        "category": "STPresetEditor",
        "icon": "$(edit)"
      },
      {
        "command": "stpe.deletePreset",
        "title": "Delete",
        "category": "STPresetEditor",
        "icon": "$(trash)"
      },
      {
        "command": "stpe.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "STPresetEditor"
      },
      {
        "command": "stpe.linkFolder",
        "title": "Link folder to cloud library",
        "category": "STPE",
        "icon": "$(link)"
      },
      {
        "command": "stpe.syncFolder",
        "title": "Sync folder with cloud library",
        "category": "STPE",
        "icon": "$(sync)"
      },
      {
        "command": "stpe.downloadMissing",
        "title": "Download missing presets",
        "category": "STPE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "stpe.downloadPreset",
        "title": "Download to folder",
        "category": "STPE",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stpe.openEditor",
          "when": "view == stpePresets",
          "group": "navigation@0"
        },
        {
          "command": "stpe.newPreset",
          "when": "view == stpePresets",
          "group": "navigation@1"
        },
        {
          "command": "stpe.refreshPresets",
          "when": "view == stpePresets",
          "group": "navigation@2"
        },
        {
          "command": "stpe.syncFolder",
          "when": "view == stpePresets",
          "group": "navigation@3"
        },
        {
          "command": "stpe.linkFolder",
          "when": "view == stpePresets",
          "group": "1_cloud@1"
        },
        {
          "command": "stpe.downloadMissing",
          "when": "view == stpePresets",
          "group": "1_cloud@2"
        }
      ],
      "view/item/context": [
        {
          "command": "stpe.open",
          "when": "view == stpePresets && viewItem == stpePreset",
          "group": "inline@1"
        },
        {
          "command": "stpe.duplicatePreset",
          "when": "view == stpePresets && viewItem == stpePreset",
          "group": "1_edit@1"
        },
        {
          "command": "stpe.renamePreset",
          "when": "view == stpePresets && viewItem == stpePreset",
          "group": "1_edit@2"
        },
        {
          "command": "stpe.deletePreset",
          "when": "view == stpePresets && viewItem == stpePreset",
          "group": "1_edit@3"
        },
        {
          "command": "stpe.revealInExplorer",
          "when": "view == stpePresets && viewItem == stpePreset",
          "group": "2_nav@1"
        },
        {
          "command": "stpe.downloadPreset",
          "when": "view == stpePresets && viewItem == stpeCloudPreset",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "stpe.open",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  }
}
